# =============================================================================
# Falcon Web Chat — Required Environment Variables
# =============================================================================
# Copy this file to .env and fill in your own values.
# NEVER commit the actual .env file to version control.
# =============================================================================

# Flask session signing key — generate a strong random value:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# If you change this, ALL existing sessions become invalid (users will be logged out).
SECRET_KEY=

# Fernet encryption key for message encryption — generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# WARNING: If you change this, existing encrypted messages become unreadable.
# To preserve access to existing encrypted data, set this to the previously used key.
ENCRYPTION_KEY=

# Admin account password hash — generate with:
#   python -c "from werkzeug.security import generate_password_hash; print(generate_password_hash('your_password'))"
# If set, an admin user will be created/promoted on application startup.
# The default admin username is "admin" (see ADMIN_USERNAME below).
# WARNING: Use the hash only; never store the plaintext password.
ADMIN_PASSWORD_HASH=

# Admin account username (optional, defaults to "admin")
# ADMIN_USERNAME=admin

# =============================================================================
# Optional Configuration
# =============================================================================

# Logging level (DEBUG, INFO, WARNING, ERROR, CRITICAL — defaults to INFO)
# LOG_LEVEL=INFO

# Flask debug mode (set to 1 for development, 0 or unset for production)
# FLASK_DEBUG=0

# TURN server for WebRTC NAT traversal
# TURN_SERVER=turn:openrelay.metered.ca:80
# TURN_USERNAME=openrelayproject
# TURN_CREDENTIAL=openrelayproject

# Database URL (defaults to sqlite:///falcon_web.db)
# SQLALCHEMY_DATABASE_URI=sqlite:///falcon_web.db

# CORS allowed origins (comma-separated, defaults to unrestricted in dev)
# CORS_ORIGIN=https://falcon.example.com
